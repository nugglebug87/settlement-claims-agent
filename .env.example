APP_ENV=development
APP_URL=http://localhost:8000
# Set your own password. Production requires at least 16 characters.
APP_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Development only. Production MUST use Railway's existing PostgreSQL service.
DATABASE_URL=sqlite:///./claims.db
# In Railway use a reference to the existing Redis service, if present.
REDIS_URL=
PORT=8000
WORKER_ENABLED=true
MONITOR_INTERVAL_SECONDS=900
# Exact hostnames, separated by commas. Blank blocks all remote discovery.
SOURCE_ALLOWED_HOSTS=
# Optional. Only used for html_ai sources; no user profile is sent to AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
